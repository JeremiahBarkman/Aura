# Auto detect text files and perform LF normalization
* text=auto

# Binary assets. Without these, `* text=auto` above plus core.autocrlf=true can
# apply LF->CRLF conversion to files git's heuristic misdetects as text, which
# silently corrupts them (the PP-HumanSeg .onnx model diffed as ~22k lines of
# "text" before this rule existed).
*.onnx binary
*.pdf binary
*.exe binary
*.dll binary
*.zip binary
*.7z binary

# Git hooks run under git's bundled sh. With `* text=auto` above plus
# core.autocrlf=true they would check out CRLF on Windows, making the `#!/bin/sh`
# line read as "/bin/sh\r" -- the hook then dies with "bad interpreter" on every
# push. Force LF so a fresh Windows clone gets a working hook.
scripts/hooks/* text eol=lf
