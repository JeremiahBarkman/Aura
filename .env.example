# Aura environment template.
#
# On first launch, Aura copies this file to create your own .env in the
# per-user data directory -- %APPDATA%\aura\.env (Roaming) on Windows,
# ~/.config/Aura/.env on Linux. Edit values THERE, not here -- this file
# ships inside the app and gets overwritten on every update. Your own copy
# is untouched by updates.
#
# Paths below are shown for both platforms. Use the ones for the machine
# you are on and delete or ignore the other.

# ============================================================================
# Segmentation Licensing (PsySeg SDK)
# ============================================================================
PSYSEG_LICENSE=
PSYSEG_ACCESS_KEY=
PSYSEG_ACCESS_TOKEN=

# ============================================================================
# SerpAPI (image search / import)
# ============================================================================
SERPAPI_KEY=

# ============================================================================
# Aura Server
# ============================================================================

PORT=5150

# ============================================================================
# AI Services
# ============================================================================

OLLAMA_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188
WHISPER_URL=http://127.0.0.1:8765

# Ollama model used for summaries/prompts/trigger text. Must be pulled in
# Ollama first (ollama pull <model>). Leave empty to use the built-in default.
OLLAMA_MODEL=

# Ollama embedding model for Play Mode semantic matching. Pull it first:
# ollama pull nomic-embed-text
# Leave empty to use the default (nomic-embed-text). If the model isn't
# available, Play Mode automatically falls back to keyword matching.
# For MULTILINGUAL libraries (non-English trigger text), use a multilingual
# embedding model instead, e.g.:  ollama pull bge-m3   then set:
# OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_MODEL=

# ============================================================================
# ComfyUI
# ============================================================================

COMFYUI_AUTOSTART=true

# Windows:
COMFYUI_WORKING_DIR=C:\PATH\TO\ComfyUI
COMFYUI_PYTHON=C:\PATH\TO\ComfyUI\venv\Scripts\python.exe
COMFYUI_OUTPUT_DIR=C:\PATH\TO\ComfyUI\output

# Linux (a venv keeps its interpreter in bin/, not Scripts/):
# COMFYUI_WORKING_DIR=/path/to/ComfyUI
# COMFYUI_PYTHON=/path/to/ComfyUI/venv/bin/python
# COMFYUI_OUTPUT_DIR=/path/to/ComfyUI/output

# ============================================================================
# Speech Service
# ============================================================================

# Windows:
SPEECH_PYTHON=C:\PATH\TO\speech\venv\Scripts\python.exe
SPEECH_SCRIPT=C:\PATH\TO\speech\speech_server.py

# Linux:
# SPEECH_PYTHON=/path/to/aura/services/speech/venv/bin/python
# SPEECH_SCRIPT=/path/to/aura/services/speech/speech_server.py

# Whisper model size. "base" (default) is multilingual -- it auto-detects
# ~99 spoken languages -- and is fast on CPU, but non-English accuracy is
# noticeably weaker than larger sizes. For serious non-English use set:
#   WHISPER_MODEL=small     (better, still CPU-practical)
#   WHISPER_MODEL=medium    (best, slower / more RAM)
# Do NOT use the ".en" variants (base.en, small.en) -- they are English-only.
WHISPER_MODEL=

# Optional GPU acceleration for Whisper (leave blank for CPU/int8 default):
#   WHISPER_DEVICE=cuda
#   WHISPER_COMPUTE_TYPE=float16
# Needs cuBLAS/cuDNN available at runtime. A system-wide CUDA Toolkit +
# cuDNN install works, or skip that multi-GB installer and run, in
# services/speech/venv:
#   pip install nvidia-cublas-cu12 nvidia-cudnn-cu12
# speech_server.py picks these up automatically when WHISPER_DEVICE=cuda.
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
