{
  "name": "aura",
  "version": "0.7.0",
  "description": "",
  "main": "electron-main.js",
  "scripts": {
    "start": "node src/web/server.js",
    "electron": "electron electron-main.js",
    "stage": "node scripts/stage-resources.js",
    "check:docs": "node scripts/check-docs-sync.js",
    "sync:docs": "node scripts/check-docs-sync.js --fix",
    "predist": "node scripts/check-docs-sync.js && node scripts/stage-resources.js",
    "dist": "electron-builder",
    "postdist": "node scripts/stage-installer.js",
    "stage:installer": "node scripts/stage-installer.js",
    "predist:dir": "node scripts/check-docs-sync.js && node scripts/stage-resources.js",
    "dist:dir": "electron-builder --dir",
    "build:prereq": "node scripts/build-prereq-bundle.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@personifyinc/psyseg-sdk": "^5.6.0",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aura.studio",
    "productName": "Aura",
    "npmRebuild": false,
    "asar": false,
    "artifactName": "Aura Installer v${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "package.json",
      ".env.example",
      "public/**/*",
      "src/**/*",
      "comfy/**/*",
      "node_modules/**/*",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort.webgpu.bundle.min.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.wasm"
    ],
    "extraResources": [
      {
        "from": "native/runtime/AuraFrameBridge.exe",
        "to": "native/AuraFrameBridge.exe"
      },
      {
        "from": "native/runtime/VCamSample.exe",
        "to": "native/VCamSample.exe"
      },
      {
        "from": "native/runtime/VCamSampleSource.dll",
        "to": "native/VCamSampleSource.dll"
      },
      {
        "from": "native/runtime/node.exe",
        "to": "node.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura"
    }
  }
}
